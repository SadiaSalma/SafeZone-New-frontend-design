# Template for api/.env  (this file IS uploaded to GitHub; .env is NOT).
# To use it:  copy .env.example .env   then change the values in .env
APP_NAME=SafeZone API
APP_ENV=development
# The website address allowed to call the backend (CORS)
WEB_ORIGIN=http://localhost:3000
# MongoDB: the project database runs on port 27018 as replica set rs0 (see scripts/start_db.py)
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DB=safezone
# One-time codes are sent to the MOBILE NUMBER:
#   demo_screen = shown on the website in a "Demo SMS" box (free, development only)
#   console     = printed in the backend window only (free, development only)
#   sms         = a real SMS through BulkSMSBD (fill in the SMS settings below)
OTP_CHANNEL=demo_screen
OTP_SECRET=put-a-long-random-text-here
OTP_MINUTES=10
# SMS company, only needed when OTP_CHANNEL=sms (BulkSMSBD: https://bulksmsbd.net -> API key + sender ID)
SMS_API_KEY=
SMS_SENDER_ID=
# Log-in tickets: JWT_SECRET signs them (keep it secret, long and random)
JWT_SECRET=put-another-long-random-text-here
ACCESS_MINUTES=15
REFRESH_DAYS=7
# NID numbers are stored only scrambled with NID_SECRET (never change it after people have added NIDs)
NID_SECRET=put-a-third-long-random-text-here

# Browser push notifications (Task 23): run  .venv\Scripts\python.exe -m scripts.make_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Reading GD photos (Task 29): empty = found automatically (C:\Program Files\Tesseract-OCR, %USERPROFILE%\tessdata)
TESSERACT_CMD=
TESSDATA_DIR=
